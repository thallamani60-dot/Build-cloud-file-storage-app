APP_NAME=Cloud File Storage API
ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cloud_file_storage
SECRET_KEY=replace-with-generated-secrets-token_urlsafe-value
ACCESS_TOKEN_EXPIRE_MINUTES=30

AWS_REGION=ap-south-1
S3_BUCKET_NAME=your-unique-private-bucket-name
# Optional: use a customer managed KMS key instead of SSE-S3.
# S3_KMS_KEY_ID=arn:aws:kms:ap-south-1:123456789012:key/replace-me
# Optional for local S3-compatible development only.
# S3_ENDPOINT_URL=http://localhost:4566
PRESIGNED_URL_EXPIRE_SECONDS=900

MAX_UPLOAD_BYTES=26214400
RATE_LIMIT_STORAGE_URI=memory://
LOG_LEVEL=INFO

# Docker Compose local development database password.
POSTGRES_PASSWORD=postgres
